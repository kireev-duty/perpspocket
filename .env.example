# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# 32+ random chars; encrypts every user's bot key at rest. Never change it after users join.
MASTER_KEY=
# Network: hideki = Somnia Tokyo testnet (Perps Arena)
NETWORK=hideki
# Set to false to send real orders
DRY_RUN=false
# Optional: your own key for scripts/once.ts (trades that key's own account)
PRIVATE_KEY=
# Optional: OWNER_ADDRESS makes PRIVATE_KEY a linked bot key trading for that account
OWNER_ADDRESS=
